digraph G {
  graph [rankdir=LR, fontname="Inter", fontsize=13, nodesep=0.3, ranksep=0.35, pad=0.3, bgcolor="white",
         label="Phase 2 (planned): implementation workflow", labelloc=t, fontcolor="#1a1a19"];
  node  [shape=box, style="rounded,filled", fontname="Inter", fontsize=10.5, color="#2a78d6", fillcolor="#dcebfb", penwidth=1.3, margin="0.14,0.08", width=2.1];
  edge  [color="#8a8985", penwidth=1.3, arrowsize=0.8];
  s1 [label="1. Fixed-point model\n(Python)\nchoose bit widths;\ncheck the same 18 bands\nare picked as in floating point"];
  s2 [label="2. RTL design\n(Verilog)\naccumulator, finaliser,\nFisher-Cholesky core,\nUART, control FSM"];
  s3 [label="3. Simulation\n(Vivado XSim)\ntestbench vs Python\ngolden reference,\nbit-exact check"];
  s4 [label="4. Synthesis +\nimplementation (Vivado)\nLUT, DSP, BRAM use;\nclock / timing closure"];
  s5 [label="5. On-board test\n(Nexys 4)\nreal data over UART;\ncycle counter for latency"];
  s6 [label="6. Evaluation\nsame bands as software?\ncompute latency, resources,\npower estimate,\ncomparison with base paper", fillcolor="#d3f1e6", color="#1baf7a", penwidth=2];
  s1 -> s2 -> s3 -> s4 -> s5 -> s6;
}
